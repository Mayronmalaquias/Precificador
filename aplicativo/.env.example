# URL base da API (Flask). O app anexa /api/v1 automaticamente.
# Web / emulador Android (localhost do host):
EXPO_PUBLIC_API_URL=http://localhost:5000
# Dispositivo físico: use o IP da sua máquina na LAN, ex.:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:5000

# Chave estática da aplicação — MESMO valor do API_SECRET_KEY do back-end.
# Inlinada no bundle no build (docs Expo v57).
EXPO_PUBLIC_API_KEY=troque-por-uma-chave-forte
