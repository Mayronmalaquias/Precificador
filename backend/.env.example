API_PREFIX=/api/v1
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
SECRET_KEY=troque-esta-chave
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Autenticacao da API ---
# Kill-switch do middleware (true em producao).
AUTH_ENABLED=true
# Chave estatica da aplicacao (header X-API-KEY). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=troque-por-uma-chave-forte
# Assinatura dos JWT do login (se vazio, usa SECRET_KEY).
JWT_SECRET=troque-por-outra-chave-forte
# Validade do JWT em segundos (padrao 12h).
JWT_EXPIRES_SECONDS=43200

IMOVIEW_CHAVE=
IMOVIEW_CODIGOACESSO=
